{
  "name": "notyra-example-notes",
  "version": "0.1.0",
  "type": "module",
  "description": "Notes API example",
  "author": "Your name",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "package": "pnpm build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@notyra/plugin-api": "file:../../vendor/plugin-api",
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "@types/node": "26.6.5",
    "@types/semver": "7.8.0",
    "jsdom": "30.1.3"
  },
  "notyra": {
    "displayName": "Notes API example",
    "type": "feature",
    "notyraVersion": "^3.1.7",
    "main": "dist/index.js",
    "permissions": [
      {
        "name": "notes:read",
        "purpose": "Find registered root folders"
      },
      {
        "name": "notes:write",
        "purpose": "Create a note when the command is run"
      }
    ]
  }
}
