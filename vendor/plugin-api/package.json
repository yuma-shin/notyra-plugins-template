{
  "name": "@notyra/plugin-api",
  "version": "3.1.7",
  "description": "Notyra plugin API and manifest types; runtime provided by the host",
  "type": "module",
  "license": "MIT",
  "files": [
    "*.d.ts",
    "*.js",
    "README.md",
    "LICENSE.md"
  ],
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./manifest": {
      "types": "./manifest.d.ts",
      "import": "./manifest.js"
    }
  },
  "dependencies": {
    "semver": "7.8.5"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@codemirror/language": "^6.13.1",
    "@codemirror/commands": "^6.11.1",
    "@lezer/highlight": "^1.2.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
