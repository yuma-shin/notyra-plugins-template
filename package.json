{
  "name": "notyra-example",
  "version": "0.1.0",
  "type": "module",
  "description": "A starter plugin for Notyra",
  "author": "Your name",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "package": "pnpm build && node scripts/package.mjs",
    "rename": "node scripts/rename.mjs"
  },
  "devDependencies": {
    "@notyra/plugin-api": "file:vendor/plugin-api",
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "@types/node": "26.6.5",
    "@types/semver": "7.8.0",
    "jsdom": "30.1.3"
  },
  "notyra": {
    "displayName": "Example Plugin / サンプルプラグイン",
    "type": "feature",
    "notyraVersion": "^3.1.7",
    "main": "dist/index.js",
    "permissions": [],
    "settings": [
      {
        "key": "prefix",
        "title": "Counter label / カウンターのラベル",
        "type": "string",
        "default": "Characters / 文字数"
      },
      {
        "key": "showCount",
        "title": "Show count / 文字数を表示",
        "type": "boolean",
        "default": true
      }
    ]
  }
}
